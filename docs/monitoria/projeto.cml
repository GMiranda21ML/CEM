import "../compartilhado/projeto.cml"
import "../acesso/projeto.cml"

ContextMap {
	contains monitoria, acesso, compartilhado

	monitoria Downstream-Upstream compartilhado
	monitoria Downstream-Upstream acesso
}

BoundedContext monitoria implements monitoria {
	Module monitoria {
		Aggregate Avaliacao {
			Entity Avaliacao {
				aggregateRoot

				-AvaliacaoIdentificador identificador key
				-SessaoIdentificador sessao
				-UsuarioIdentificador autor
				AvaliacaoPerfil perfil
				int nota
				nullable String comentario
				DateTime registradaEm
				DateTime atualizadaEm

				Repository AvaliacaoRepository {
					@Avaliacao incluir(@Avaliacao agregado);
					boolean existePorIdentificador(@AvaliacaoIdentificador identificador);
					@Avaliacao buscarPorIdentificador(@AvaliacaoIdentificador identificador);
					void alterar(@Avaliacao agregado);
					boolean existePorSessaoEAutor(@SessaoIdentificador sessao, @UsuarioIdentificador autor);
				}
			}

			enum AvaliacaoPerfil {
				ALUNO, MONITOR_DE_SESSAO
			}

			ValueObject AvaliacaoIdentificador {
				String valor
			}

			Service AvaliacaoServico {
				@Avaliacao registrar(@SessaoIdentificador sessao, int nota, String comentario);
				@Avaliacao buscar(@AvaliacaoIdentificador identificador);
				void editar(@AvaliacaoIdentificador identificador, int nota, String comentario);
			}
		}
		// Funcionalidades F008, F009, F010 e F011
		Aggregate Sessao {
			ValueObject SessaoIdentificador { String valor }
			enum SituacaoRespostaSessao { SEM_RESPOSTA, VAI_PARTICIPAR, NAO_VAI_PARTICIPAR }
			ValueObject RespostaSessao {
				-UsuarioIdentificador aluno
				SituacaoRespostaSessao situacao
				nullable String motivo
				nullable DateTime inicioSugerido
			}
			Entity Sessao {
				aggregateRoot
				-SessaoIdentificador identificador key
				String disciplina
				-UsuarioIdentificador professor
				-UsuarioIdentificador monitor
				-CampusIdentificador campus
				String sala
				Collection<UsuarioIdentificador> alunos
				Collection<RespostaSessao> respostas
				DateTime inicio
				DateTime fim
				nullable DateTime inicioAnterior
				boolean cancelada
				Repository SessaoRepository {
					boolean existePorMonitor(@UsuarioIdentificador monitor);
					@Sessao incluir(@Sessao agregado);
					boolean existePorIdentificador(@SessaoIdentificador identificador);
					@Sessao buscarPorIdentificador(@SessaoIdentificador identificador);
					void alterar(@Sessao agregado);
					void excluir(@SessaoIdentificador identificador);
					boolean conflita(@UsuarioIdentificador monitor, @UsuarioIdentificador aluno, DateTime inicio, DateTime fim);
					void bloquearAgenda(@UsuarioIdentificador monitor);
					Collection<@Sessao> listarPorDisciplina(String disciplina);
				}
			}
			Service SessaoServico {
				@Sessao buscar(@SessaoIdentificador identificador);
				@Sessao registrar(@Sessao agregado);
				@Sessao adicionarAluno(@SessaoIdentificador sessao, @UsuarioIdentificador aluno);
				@Sessao responder(@SessaoIdentificador sessao, @RespostaSessao resposta);
				@Sessao remarcarParaSugestao(@SessaoIdentificador sessao, @UsuarioIdentificador aluno);
				void cancelar(@SessaoIdentificador identificador);
			}
		}
		Aggregate Disponibilidade {
			Entity Disponibilidade {
				aggregateRoot
				-DisponibilidadeIdentificador identificador key
				String disciplina
				-UsuarioIdentificador monitor
				-CampusIdentificador campus
				int diaSemana
				String inicio
				String fim
				Repository DisponibilidadeRepository {
					@Disponibilidade incluir(@Disponibilidade agregado);
					boolean existePorIdentificador(@DisponibilidadeIdentificador identificador);
					@Disponibilidade buscarPorIdentificador(@DisponibilidadeIdentificador identificador);
					void alterar(@Disponibilidade agregado);
					void excluir(@DisponibilidadeIdentificador identificador);
					Collection<@Disponibilidade> buscarDoMonitor(@UsuarioIdentificador monitor, String disciplina);
					Collection<@Disponibilidade> listarDoMonitor(@UsuarioIdentificador monitor);
				}
			}
			ValueObject DisponibilidadeIdentificador { String valor }
			Service DisponibilidadeServico {
				@Disponibilidade buscar(@DisponibilidadeIdentificador identificador);
				@Disponibilidade incluir(@Disponibilidade agregado);
				void alterar(@Disponibilidade agregado);
				void excluir(@DisponibilidadeIdentificador identificador);
			}
		}
		Aggregate Falta {
			Entity Falta {
				aggregateRoot
				-FaltaIdentificador identificador key
				-SessaoIdentificador sessao
				-UsuarioIdentificador pessoa
				String papel
				-UsuarioIdentificador autor
				nullable String observacao
				DateTime registradaEm
				nullable -SessaoIdentificador reposicao
				Repository FaltaRepository {
					@Falta incluir(@Falta agregado);
					boolean existePorIdentificador(@FaltaIdentificador identificador);
					@Falta buscarPorIdentificador(@FaltaIdentificador identificador);
					void alterar(@Falta agregado);
					void excluir(@FaltaIdentificador identificador);
					boolean existePorSessaoEPessoa(@SessaoIdentificador sessao, @UsuarioIdentificador pessoa);
					long contar(@UsuarioIdentificador pessoa, String papel, String disciplina);
					Collection<@Falta> listarPorDisciplina(String disciplina);
				}
			}
			ValueObject FaltaIdentificador { String valor }
			ValueObject SugestaoReposicao {
				DateTime inicio
				DateTime fim
				-CampusIdentificador campus
			}
			Service FaltaServico {
				@Falta buscar(@FaltaIdentificador identificador);
				@Falta registrar(@SessaoIdentificador sessao, @UsuarioIdentificador pessoa, String papel, String observacao);
				void editar(@FaltaIdentificador identificador, String observacao);
				List<SugestaoReposicao> sugerir(@FaltaIdentificador identificador);
				@Sessao agendar(@FaltaIdentificador identificador, SugestaoReposicao escolha);
				void excluir(@FaltaIdentificador identificador);
			}
		}
		Aggregate Alerta {
			Service CoordenadoresAlertaServico {
				Collection<@Usuario> buscarPorPessoa(@UsuarioIdentificador pessoa);
			}
			Entity Alerta {
				aggregateRoot
				-AlertaIdentificador identificador key
				-UsuarioIdentificador pessoa
				String papel
				String disciplina
				boolean acompanhado
				DateTime criadoEm
				Repository AlertaRepository {
					@Alerta incluir(@Alerta agregado);
					boolean existePorIdentificador(@AlertaIdentificador identificador);
					@Alerta buscarPorIdentificador(@AlertaIdentificador identificador);
					void alterar(@Alerta agregado);
					void excluir(@AlertaIdentificador identificador);
					boolean existeNovo(@UsuarioIdentificador pessoa, String papel, String disciplina);
				}
			}
			ValueObject AlertaIdentificador { String valor }
			Service AlertaServico {
				@Alerta buscar(@AlertaIdentificador identificador);
				void acompanhar(@AlertaIdentificador identificador);
				long contar(@AlertaIdentificador identificador);
			}
		}
		// Funcionalidades F006 e F013
		Aggregate Selecao {
			Entity Selecao {
				aggregateRoot

				-SelecaoIdentificador identificador key
				-DisciplinaIdentificador disciplina
				-UsuarioIdentificador professor
				String semestre
				Date prazoInscricao
				int vagas
				double crMinimo
				int pesoCr
				int pesoEntrevista
				double patamarMinimo
				SelecaoSituacao situacao
				nullable String motivoEncerramento
				Date abertaEm
				nullable Date encerradaEm

				Repository SelecaoRepository {
					@Selecao incluir(@Selecao agregado);
					boolean existePorIdentificador(@SelecaoIdentificador identificador);
					@Selecao buscarPorIdentificador(@SelecaoIdentificador identificador);
					void alterar(@Selecao agregado);
					boolean existeAbertaPorDisciplina(@DisciplinaIdentificador disciplina, @SelecaoIdentificador ignorado);
				}
			}

			enum SelecaoSituacao {
				ABERTA, ENCERRADA
			}

			// artificial
			ValueObject SelecaoIdentificador {
				String valor
			}

			Service SelecaoServico {
				@Selecao buscar(@SelecaoIdentificador identificador);
				@Selecao abrir(@DisciplinaIdentificador disciplina, Date prazoInscricao, int vagas, double crMinimo, int pesoCr, int pesoEntrevista, double patamarMinimo);
				@Selecao editar(@SelecaoIdentificador identificador, Date prazoInscricao, int vagas, double crMinimo, int pesoCr, int pesoEntrevista, double patamarMinimo);
				@Selecao encerrar(@SelecaoIdentificador identificador);
			}
		}

		Aggregate Candidatura {
			Entity Candidatura {
				aggregateRoot

				-CandidaturaIdentificador identificador key
				-SelecaoIdentificador selecao
				-DisciplinaIdentificador disciplina
				-UsuarioIdentificador aluno
				double cr
				CandidaturaSituacao situacao
				nullable double notaEntrevista
				nullable String comentarioEntrevista
				nullable double resultadoFinal
				nullable String motivoDecisao
				DateTime criadaEm
				nullable Date decididaEm

				Repository CandidaturaRepository {
					@Candidatura incluir(@Candidatura agregado);
					boolean existePorIdentificador(@CandidaturaIdentificador identificador);
					@Candidatura buscarPorIdentificador(@CandidaturaIdentificador identificador);
					void alterar(@Candidatura agregado);
					boolean existePorSelecao(@SelecaoIdentificador selecao);
					boolean existeAtivaPorAlunoEDisciplina(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
					long contarMonitoriasAtivasNoSemestre(@UsuarioIdentificador aluno, String semestre, @DisciplinaIdentificador disciplinaIgnorada);
					boolean ehMonitorAtivo(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
					boolean ehMonitorEmAlgumaDisciplina(@UsuarioIdentificador aluno);
					Collection<@Candidatura> listarPorSelecao(@SelecaoIdentificador selecao);
				}
			}

			enum CandidaturaSituacao {
				PENDENTE, APROVADA, REPROVADA, CANCELADA
			}

			// artificial
			ValueObject CandidaturaIdentificador {
				String valor
			}

			Service CandidaturaServico {
				@Candidatura buscar(@CandidaturaIdentificador identificador);
				@Candidatura candidatar(@SelecaoIdentificador selecao, double cr);
				@Candidatura cancelar(@CandidaturaIdentificador identificador);
				@Candidatura registrarEntrevista(@CandidaturaIdentificador identificador, double nota, String comentario);
				@Candidatura aprovar(@CandidaturaIdentificador identificador);
				@Candidatura reprovar(@CandidaturaIdentificador identificador);
			}
		}

		Aggregate Acompanhamento {
			Entity Acompanhamento {
				aggregateRoot

				-AcompanhamentoIdentificador identificador key
				-UsuarioIdentificador aluno
				-DisciplinaIdentificador disciplina
				-UsuarioIdentificador monitor
				String semestre
				double metaNota
				int metaFrequencia
				AcompanhamentoSituacao situacao
				Date abertoEm
				nullable Date encerradoEm
				nullable String parecerFinal

				Repository AcompanhamentoRepository {
					@Acompanhamento incluir(@Acompanhamento agregado);
					boolean existePorIdentificador(@AcompanhamentoIdentificador identificador);
					@Acompanhamento buscarPorIdentificador(@AcompanhamentoIdentificador identificador);
					void alterar(@Acompanhamento agregado);
					void excluir(@AcompanhamentoIdentificador identificador);
					boolean existeAtivoPorAlunoEDisciplina(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
					boolean existeEncerradoPorAlunoEDisciplina(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
					boolean existeBloqueioPorEncerramento(@UsuarioIdentificador aluno, String disciplinaNomeOuCodigo, @UsuarioIdentificador professor);
				}
			}

			enum AcompanhamentoSituacao {
				ATIVO, ENCERRADO
			}

			enum TendenciaEvolucao {
				EM_EVOLUCAO, EM_QUEDA, ESTAVEL, DADOS_INSUFICIENTES
			}

			enum SituacaoDesempenho {
				META_ATINGIDA, EM_PROGRESSO, ESTAVEL, ATENCAO, DADOS_INSUFICIENTES
			}

			ValueObject AcompanhamentoIdentificador {
				String valor
			}

			ValueObject SessaoRelatorioItem {
				-SessaoIdentificador sessao
				Date data
				String situacao
				boolean valida
				boolean presente
				nullable double nota
				nullable String comentario
			}

			ValueObject RelatorioDesempenho {
				-AcompanhamentoIdentificador acompanhamento
				nullable Date de
				nullable Date ate
				boolean filtroIgnorado
				int totalSessoesValidas
				int totalPresencas
				nullable double frequenciaPercentual
				int quantidadeNotas
				nullable double mediaNotas
				nullable double notaInicial
				nullable double notaAtual
				nullable double variacaoNotas
				nullable double inclinacaoTendencia
				TendenciaEvolucao tendencia
				SituacaoDesempenho situacao
				List<SessaoRelatorioItem> sessoes
			}

			Service AcompanhamentoServico {
				@Acompanhamento buscar(@AcompanhamentoIdentificador identificador);
				@Acompanhamento abrir(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina, double metaNota, int metaFrequencia);
				@Acompanhamento editarMetas(@AcompanhamentoIdentificador identificador, double metaNota, int metaFrequencia);
				@Acompanhamento encerrar(@AcompanhamentoIdentificador identificador, String parecerFinal);
				void excluir(@AcompanhamentoIdentificador identificador);
				@RelatorioDesempenho emitirRelatorio(@AcompanhamentoIdentificador identificador, Date de, Date ate);
			}
		}

		Aggregate Feedback {
			Entity Feedback {
				aggregateRoot

				-FeedbackIdentificador identificador key
				-SessaoIdentificador sessao
				-UsuarioIdentificador aluno
				-UsuarioIdentificador autor
				double nota
				nullable String comentario
				Date criadoEm
				nullable Date atualizadoEm

				Repository FeedbackRepository {
					@Feedback incluir(@Feedback agregado);
					boolean existePorIdentificador(@FeedbackIdentificador identificador);
					@Feedback buscarPorIdentificador(@FeedbackIdentificador identificador);
					void alterar(@Feedback agregado);
					void excluir(@FeedbackIdentificador identificador);
					boolean existePorSessaoEAluno(@SessaoIdentificador sessao, @UsuarioIdentificador aluno);
					boolean existePorAlunoEDisciplina(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
					List<@Feedback> listarPorAlunoEDisciplina(@UsuarioIdentificador aluno, @DisciplinaIdentificador disciplina);
				}
			}

			// artificial
			ValueObject FeedbackIdentificador {
				String valor
			}

			Service FeedbackServico {
				@Feedback buscar(@FeedbackIdentificador identificador);
				@Feedback registrar(@SessaoIdentificador sessao, @UsuarioIdentificador aluno, double nota, String comentario);
				@Feedback editar(@FeedbackIdentificador identificador, double nota, String comentario);
				void excluir(@FeedbackIdentificador identificador);
			}
		}
	}
}
