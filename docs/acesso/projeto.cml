import "../compartilhado/projeto.cml"

ContextMap {
	contains acesso, compartilhado

	acesso Downstream-Upstream compartilhado
}

BoundedContext acesso implements acesso {
	Module acesso {
		Aggregate DominioEmail {
			Entity DominioEmail {
				aggregateRoot

				-DominioEmailDominio dominio key

				Repository DominioEmailRepository {
					@DominioEmail incluir(@DominioEmail agregado);
					boolean existePorIdentificador(@DominioEmailDominio identificador);
					@DominioEmail buscarPorIdentificador(@DominioEmailDominio identificador);
					void excluir(@DominioEmailDominio identificador);
				}
			}

			// natural
			ValueObject DominioEmailDominio {
				String valor
			}

			Service DominioEmailServico {
				@DominioEmail incluir(@DominioEmail agregado);
				@DominioEmail buscar(@DominioEmailDominio identificador);
				void excluir(@DominioEmailDominio identificador);
			}
		}

		Aggregate Convite {
			Entity Convite {
				aggregateRoot

				-ConviteIdentificador identificador key
				ConviteEmail emailInstitucional
				Autorizacao papel
				String curso
				ConviteCodigo codigo
				DateTime enviadoEm
				DateTime validoAte
				ConviteSituacao situacao

				Repository ConviteRepository {
					@Convite incluir(@Convite agregado);
					boolean existePorIdentificador(@ConviteIdentificador identificador);
					@Convite buscarPorIdentificador(@ConviteIdentificador identificador);
					void alterar(@Convite agregado);
					void excluir(@ConviteIdentificador identificador);

					boolean existePendentePorEmail(@ConviteEmail emailInstitucional);
					@Convite buscarPendentePorEmail(@ConviteEmail emailInstitucional);
				}
			}

			enum ConviteSituacao {
				AGUARDANDO_ACEITE, ACEITO, CANCELADO
			}

			// artificial
			ValueObject ConviteIdentificador {
				String valor
			}

			ValueObject ConviteEmail {
				String valor
			}

			ValueObject ConviteCodigo {
				String valor
			}

			Service ConviteServico {
				@Convite buscar(@ConviteIdentificador identificador);
				void excluir(@ConviteIdentificador identificador);

				// monta o convite com um código gerado, inclui e envia o e-mail com esse código
				@Convite convidar(@ConviteEmail emailInstitucional, Autorizacao papel, String curso);
				void reenviar(@ConviteIdentificador identificador);
				void cancelar(@ConviteIdentificador identificador);
				@Usuario aceitar(@ConviteEmail emailInstitucional, @ConviteCodigo codigo, String nome, @UsuarioSenha senha);
			}
		}

		Aggregate Usuario {
			Entity Usuario {
				aggregateRoot

				-UsuarioIdentificador identificador key
				String nome
				UsuarioEmail emailInstitucional
				UsuarioSenha senha
				Autorizacao papel
				nullable String curso
				nullable String campus
				UsuarioSituacao situacao

				Repository UsuarioRepository {
					@Usuario incluir(@Usuario agregado);
					boolean existePorIdentificador(@UsuarioIdentificador identificador);
					@Usuario buscarPorIdentificador(@UsuarioIdentificador identificador);
					void alterar(@Usuario agregado);
					void excluir(@UsuarioIdentificador identificador);

					boolean existePorEmail(@UsuarioEmail emailInstitucional);
					@Usuario buscarPorEmail(@UsuarioEmail emailInstitucional);
				}
			}

			enum UsuarioSituacao {
				ATIVO, INATIVO
			}

			// artificial
			ValueObject UsuarioIdentificador {
				String valor
			}

			// natural
			ValueObject UsuarioEmail {
				String valor
			}

			ValueObject UsuarioSenha {
				String valor
			}

			Service UsuarioServico {
				@Usuario buscar(@UsuarioIdentificador identificador);
				void alterar(@Usuario agregado);
				void excluir(@UsuarioIdentificador identificador);

				// inclui e envia o e-mail de boas-vindas (autocadastro de aluno)
				@Usuario criarConta(@Usuario agregado);
				void inativar(@UsuarioIdentificador identificador);
				void reativar(@UsuarioIdentificador identificador);
			}
		}

		Aggregate Campus {
			Entity Campus {
				aggregateRoot

				-CampusIdentificador identificador key
				-InstituicaoIdentificador instituicao
				String nome
				nullable String endereco
				CampusSituacao situacao

				Repository CampusRepository {
					@Campus incluir(@Campus agregado);
					boolean existePorIdentificador(@CampusIdentificador identificador);
					@Campus buscarPorIdentificador(@CampusIdentificador identificador);
					void alterar(@Campus agregado);
					boolean existePorNome(String nome, @InstituicaoIdentificador instituicao);
					boolean existeOutroPorNome(String nome, @InstituicaoIdentificador instituicao, @CampusIdentificador identificador);
				}
			}

			enum CampusSituacao {
				ATIVO, INATIVO
			}

			ValueObject CampusIdentificador {
				String valor
			}

			ValueObject InstituicaoIdentificador {
				String valor
			}

			Service CampusServico {
				@Campus cadastrar(String nome, String endereco);
				@Campus buscar(@CampusIdentificador identificador);
				void alterar(@Campus agregado);
				void inativar(@CampusIdentificador identificador);
				void reativar(@CampusIdentificador identificador);
				boolean estaAtivo(@CampusIdentificador identificador);
			}
		}

		Aggregate Curso {
			Entity Curso {
				aggregateRoot

				-CursoIdentificador identificador key
				-InstituicaoIdentificador instituicao
				String nome
				String sigla

				Repository CursoRepository {
					@Curso incluir(@Curso agregado);
					boolean existePorIdentificador(@CursoIdentificador identificador);
					@Curso buscarPorIdentificador(@CursoIdentificador identificador);
					void excluir(@CursoIdentificador identificador);

					boolean existePorNome(String nome, @InstituicaoIdentificador instituicao);
					boolean existePorSigla(String sigla, @InstituicaoIdentificador instituicao);
					boolean possuiDisciplinasVinculadas(@CursoIdentificador identificador);
					boolean possuiUsuariosVinculados(@CursoIdentificador identificador);
				}
			}

			// artificial
			ValueObject CursoIdentificador {
				String valor
			}

			Service CursoServico {
				@Curso cadastrar(String nome, String sigla);
				@Curso buscar(@CursoIdentificador identificador);
				void excluir(@CursoIdentificador identificador);
			}
		}

		Aggregate Disciplina {
			Entity Disciplina {
				aggregateRoot

				-DisciplinaIdentificador identificador key
				-InstituicaoIdentificador instituicao
				-CursoIdentificador curso
				-UsuarioIdentificador professor
				String nome
				-DisciplinaCodigo codigo
				String area

				Repository DisciplinaRepository {
					@Disciplina incluir(@Disciplina agregado);
					boolean existePorIdentificador(@DisciplinaIdentificador identificador);
					@Disciplina buscarPorIdentificador(@DisciplinaIdentificador identificador);
					void alterar(@Disciplina agregado);
					void excluir(@DisciplinaIdentificador identificador);

					boolean existePorCodigo(@DisciplinaCodigo codigo, @InstituicaoIdentificador instituicao);
					boolean existePorNomeNoCurso(String nome, @CursoIdentificador curso, @DisciplinaIdentificador identificadorIgnorado);
					boolean possuiVinculosMonitoria(@DisciplinaIdentificador identificador);
				}
			}

			// artificial
			ValueObject DisciplinaIdentificador {
				String valor
			}

			// natural (padrão AAA0000)
			ValueObject DisciplinaCodigo {
				String valor
			}

			Service DisciplinaServico {
				@Disciplina cadastrar(String nome, @DisciplinaCodigo codigo, String area, @CursoIdentificador curso, @UsuarioIdentificador professor);
				@Disciplina buscar(@DisciplinaIdentificador identificador);
				void alterar(@Disciplina agregado);
				void excluir(@DisciplinaIdentificador identificador);
			}

			Service ProfessorValidadorServico {
				boolean isProfessorValido(@UsuarioIdentificador professor, @CursoIdentificador curso, @InstituicaoIdentificador instituicao);
			}
		}
	}
}
