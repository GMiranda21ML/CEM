import "../compartilhado/projeto.cml"

ContextMap {
	contains acesso, compartilhado

	acesso Downstream-Upstream compartilhado
}

BoundedContext acesso implements acesso {
	Module acesso {
		Aggregate DominioEmail {
			Entity DominioEmail {
				aggregateRoot

				-DominioEmailDominio dominio key

				Repository DominioEmailRepository {
					@DominioEmail incluir(@DominioEmail agregado);
					boolean existePorIdentificador(@DominioEmailDominio identificador);
					@DominioEmail buscarPorIdentificador(@DominioEmailDominio identificador);
					void excluir(@DominioEmailDominio identificador);
				}
			}

			// natural
			ValueObject DominioEmailDominio {
				String valor
			}

			Service DominioEmailServico {
				@DominioEmail incluir(@DominioEmail agregado);
				@DominioEmail buscar(@DominioEmailDominio identificador);
				void excluir(@DominioEmailDominio identificador);
			}
		}

		Aggregate Convite {
			Entity Convite {
				aggregateRoot

				-ConviteIdentificador identificador key
				ConviteEmail emailInstitucional
				Autorizacao papel
				String curso
				ConviteCodigo codigo
				DateTime enviadoEm
				DateTime validoAte
				ConviteSituacao situacao

				Repository ConviteRepository {
					@Convite incluir(@Convite agregado);
					boolean existePorIdentificador(@ConviteIdentificador identificador);
					@Convite buscarPorIdentificador(@ConviteIdentificador identificador);
					void alterar(@Convite agregado);
					void excluir(@ConviteIdentificador identificador);

					boolean existePendentePorEmail(@ConviteEmail emailInstitucional);
					@Convite buscarPendentePorEmail(@ConviteEmail emailInstitucional);
				}
			}

			enum ConviteSituacao {
				AGUARDANDO_ACEITE, ACEITO, CANCELADO
			}

			// artificial
			ValueObject ConviteIdentificador {
				String valor
			}

			ValueObject ConviteEmail {
				String valor
			}

			ValueObject ConviteCodigo {
				String valor
			}

			Service ConviteServico {
				@Convite buscar(@ConviteIdentificador identificador);
				void excluir(@ConviteIdentificador identificador);

				// monta o convite com um código gerado, inclui e envia o e-mail com esse código
				@Convite convidar(@ConviteEmail emailInstitucional, Autorizacao papel, String curso);
				void reenviar(@ConviteIdentificador identificador);
				void cancelar(@ConviteIdentificador identificador);
				@Usuario aceitar(@ConviteEmail emailInstitucional, @ConviteCodigo codigo, String nome, @UsuarioSenha senha);
			}
		}

		Aggregate Usuario {
			Entity Usuario {
				aggregateRoot

				-UsuarioIdentificador identificador key
				String nome
				UsuarioEmail emailInstitucional
				UsuarioSenha senha
				Autorizacao papel
				nullable String curso
				nullable String campus
				UsuarioSituacao situacao

				Repository UsuarioRepository {
					@Usuario incluir(@Usuario agregado);
					boolean existePorIdentificador(@UsuarioIdentificador identificador);
					@Usuario buscarPorIdentificador(@UsuarioIdentificador identificador);
					void alterar(@Usuario agregado);
					void excluir(@UsuarioIdentificador identificador);

					boolean existePorEmail(@UsuarioEmail emailInstitucional);
					@Usuario buscarPorEmail(@UsuarioEmail emailInstitucional);
				}
			}

			enum UsuarioSituacao {
				ATIVO, INATIVO
			}

			// artificial
			ValueObject UsuarioIdentificador {
				String valor
			}

			// natural
			ValueObject UsuarioEmail {
				String valor
			}

			ValueObject UsuarioSenha {
				String valor
			}

			Service UsuarioServico {
				@Usuario buscar(@UsuarioIdentificador identificador);
				void alterar(@Usuario agregado);
				void excluir(@UsuarioIdentificador identificador);

				// inclui e envia o e-mail de boas-vindas (autocadastro de aluno)
				@Usuario criarConta(@Usuario agregado);
				void inativar(@UsuarioIdentificador identificador);
				void reativar(@UsuarioIdentificador identificador);
			}
		}
	}
}
